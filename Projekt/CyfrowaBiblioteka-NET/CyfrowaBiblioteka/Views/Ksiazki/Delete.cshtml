@model Ksiazka
@{
    ViewData["Title"] = "Usuń książkę";
}

<h1>Usuń książkę</h1>

<p>Czy na pewno chcesz usunąć książkę <strong>@Model.Tytul</strong>?</p>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn-usun">Tak, usuń</button>
    <a asp-action="Index" class="btn-szary">Anuluj</a>
</form>
