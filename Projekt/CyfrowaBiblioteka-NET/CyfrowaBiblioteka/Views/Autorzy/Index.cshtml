@model List<Autor>
@{
    ViewData["Title"] = "Autorzy";
}

<h1>Autorzy</h1>

<a asp-action="Create" class="btn-dodaj">+ Dodaj autora</a>

<table>
    <thead>
        <tr>
            <th>Imię i nazwisko</th>
            <th>Liczba książek</th>
            <th>Akcje</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var a in Model)
        {
            <tr>
                <td>@a.ImieNazwisko</td>
                <td>@a.Ksiazki.Count</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@a.Id">Edytuj</a>
                    <a asp-action="Delete" asp-route-id="@a.Id">Usuń</a>
                </td>
            </tr>
        }
    </tbody>
</table>

@if (Model.Count == 0)
{
    <p>Brak autorów.</p>
}
