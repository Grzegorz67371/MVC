@model Autor
@{
    ViewData["Title"] = "Usuń autora";
}

<h1>Usuń autora</h1>

<p>Czy na pewno chcesz usunąć autora <strong>@Model.ImieNazwisko</strong>?</p>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn-usun">Tak, usuń</button>
    <a asp-action="Index" class="btn-szary">Anuluj</a>
</form>
