@model List<Ksiazka>
@{
    ViewData["Title"] = "Książki";
}

<h1>Książki</h1>

<form method="get" class="szukaj-form">
    <input type="text" name="szukaj" value="@ViewBag.Szukaj" placeholder="Szukaj po tytule..." />
    <select name="autorId" asp-items="ViewBag.Autorzy">
        <option value="">-- wszyscy autorzy --</option>
    </select>
    <button type="submit">Szukaj</button>
    <a asp-action="Index" class="btn-szary">Wyczyść</a>
</form>

<a asp-action="Create" class="btn-dodaj">+ Dodaj książkę</a>

<table>
    <thead>
        <tr>
            <th>Tytuł</th>
            <th>Autor</th>
            <th>Rok wydania</th>
            <th>Akcje</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var k in Model)
        {
            <tr>
                <td>@k.Tytul</td>
                <td>@k.Autor?.ImieNazwisko</td>
                <td>@k.RokWydania</td>
                <td>
                    <a asp-action="Details" asp-route-id="@k.Id">Szczegóły</a>
                    <a asp-action="Edit" asp-route-id="@k.Id">Edytuj</a>
                    <a asp-action="Delete" asp-route-id="@k.Id">Usuń</a>
                </td>
            </tr>
        }
    </tbody>
</table>

@if (Model.Count == 0)
{
    <p>Brak książek do wyświetlenia.</p>
}
